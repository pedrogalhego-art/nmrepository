# Porta (o Render injeta a dele automaticamente)
PORT=3000

# Chave secreta da sessão (troque por uma string longa aleatória)
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria

# Credenciais iniciais (só valem na primeira vez que o banco for criado)
ADMIN_PASSWORD=admin123
PROJETO_PASSWORD=projeto123

# ===== IA (Hermes - Agent) =====
# A base URL padrão aponta para um túnel local (só funciona enquanto o
# PC de origem estiver ligado com o túnel ativo). No Render, configure
# para um endpoint público da mesma API, ou deixe sem AI_API_KEY para
# desativar a IA.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=free-first
AI_DAILY_LIMIT=30000